{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/week833/stock/docs/schemas/canonical_row.schema.json",
  "title": "D-stock canonical market row",
  "description": "central market_update 與 data collect tool 共用的單列契約。兩個程式輸出同一形狀後才能互相補資料。",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "dataset",
    "row_key",
    "row_date",
    "availability_basis",
    "source_id",
    "source_class",
    "market",
    "unit_basis",
    "price_basis",
    "value_hash",
    "quarantined",
    "ingested_at",
    "values"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "dstock.market.canonical" },
    "schema_version": { "const": 1 },
    "dataset": {
      "description": "logical table 名稱，兩個來源必須使用同一個字串。",
      "type": "string",
      "enum": [
        "daily_price",
        "institutional_investors",
        "broker_branch",
        "margin_short_sale",
        "shareholding",
        "month_revenue",
        "financial_statements",
        "dividend_event",
        "trading_calendar",
        "market_membership"
      ]
    },
    "row_key": {
      "description": "正規化 join key，欄位以 | 連接，順序由 dataset 固定。例如 daily_price 為 '2330|2026-09-03'。",
      "type": "string",
      "minLength": 1
    },
    "row_date": {
      "description": "資料日／交易日。不等於可得時間。",
      "type": "string",
      "format": "date"
    },
    "availability_time": {
      "description": "此列在現實世界可被取得的時間。無證據時為 null，並由 availability_basis 說明推導方式。",
      "type": ["string", "null"],
      "format": "date-time"
    },
    "availability_basis": {
      "description": "availability_time 的依據。conservative_lag 表示以保守延遲推得，不是實際公告時間。",
      "type": "string",
      "enum": ["announced", "created", "vendor_publish", "conservative_lag", "unknown"]
    },
    "source_id": {
      "type": "string",
      "enum": ["market_update", "finmind_collect", "mitake_ui"]
    },
    "source_class": {
      "type": "string",
      "enum": ["primary", "backup", "reference_only"]
    },
    "market": {
      "description": "此列 row_date 當下的市場別，必須有 as-of membership 證據；沒有證據為 unknown。",
      "type": "string",
      "enum": ["twse", "tpex", "emerging", "not_applicable", "unknown"]
    },
    "unit_basis": {
      "description": "values 內成交量欄位的原始單位。canonical 一律另存 shares，unit_basis 保留原始語意。",
      "type": "string",
      "enum": ["shares", "lots", "not_applicable", "unknown"]
    },
    "price_basis": {
      "description": "raw 與 adjusted 不得混入同一價格序列。",
      "type": "string",
      "enum": ["raw", "adjusted", "not_applicable"]
    },
    "adj_snapshot_id": {
      "description": "adjusted 價格所屬的凍結 snapshot；重抓不覆蓋既有 snapshot，另存新 id。",
      "type": ["string", "null"]
    },
    "value_hash": {
      "description": "values 正規化後的 sha256 十六進位值，用於跨來源逐列比對。",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "quality_flags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "zero_price_no_published_trade",
          "emerging_open_is_prev_avg",
          "broker_price_zero_with_volume",
          "limit_absent_not_null",
          "estimated_value",
          "stale_snapshot",
          "duplicate_key",
          "unit_unconvertible",
          "schema_unknown"
        ]
      },
      "uniqueItems": true
    },
    "quarantined": {
      "description": "true 表示此列保留為證據但不得進入正式 join、特徵或報告。",
      "type": "boolean"
    },
    "ingested_at": {
      "type": "string",
      "format": "date-time"
    },
    "values": {
      "description": "業務欄位。同一 dataset 的欄位名稱與型別在兩個來源必須一致。",
      "type": "object",
      "minProperties": 1
    }
  },
  "allOf": [
    {
      "if": { "properties": { "price_basis": { "const": "adjusted" } }, "required": ["price_basis"] },
      "then": { "properties": { "adj_snapshot_id": { "type": "string", "minLength": 1 } }, "required": ["adj_snapshot_id"] }
    },
    {
      "if": { "properties": { "availability_basis": { "const": "unknown" } }, "required": ["availability_basis"] },
      "then": { "properties": { "quarantined": { "const": true } } }
    },
    {
      "if": { "properties": { "unit_basis": { "const": "unknown" } }, "required": ["unit_basis"] },
      "then": { "properties": { "quarantined": { "const": true } } }
    },
    {
      "if": { "properties": { "market": { "const": "unknown" } }, "required": ["market"] },
      "then": { "properties": { "quarantined": { "const": true } } }
    }
  ]
}
